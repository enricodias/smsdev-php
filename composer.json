{
    "name": "enricodias/smsdev",
    "type": "library",
    "license": "MIT",
    "description": "Send and receive SMS using SmsDev.com.br",
    "keywords": ["smsdev", "sms"],
    "authors": [
        {
            "name": "Enrico Dias",
            "email": "enrico@enricodias.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^7.3 || ^8.0",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "suggest": {
        "giggsey/libphonenumber-for-php": "Allows phone number verification",
        "guzzlehttp/guzzle": "PSR-18 HTTP client used together with php-http/discovery for auto discovery"
    },
    "autoload": {
        "psr-4": {
            "enricodias\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "enricodias\\SmsDev\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.13",
        "phpunit/phpunit": "^9.6",
        "scrutinizer/ocular": "^1.9"
    }
}
